
{
  "name": "NeteaseCloudMusicApi",
  "version": "4.14.1",
  "description": "网易云音乐 Node.js API service",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "test": "jest --forceExit --detectOpenHandles",
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "vercel-build": "npm install --production"
  },
  "author": "Binaryify",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Binaryify/NeteaseCloudMusicApi.git"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "axios": "^0.21.1",
    "express": "^4.17.1",
    "express-session": "^1.17.2",
    "helmet": "^4.6.0",
    "js-base64": "^3.6.0",
    "jsencrypt": "^3.0.0-rc.1",
    "lodash": "^4.17.21",
    "moment": "^2.29.1",
    "mongodb": "^3.6.9",
    "mongoose": "^5.13.5",
    "multer": "^1.4.2",
    "node-cache": "^5.1.2",
    "node-fetch": "^2.6.1",
    "nodemailer": "^6.6.3",
    "qrcode": "^1.4.4",
    "request": "^2.88.2",
    "request-promise": "^4.2.6",
    "tough-cookie": "^4.0.0",
    "tunnel": "^0.0.6",
    "unblockneteasemusic": "^1.1.11",
    "ws": "^7.5.3",
    "xml2js": "^0.4.23",
    "yargs": "^17.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/jest": "^26.0.24",
    "@types/node": "^16.4.13",
    "@types/request": "^2.48.7",
    "@types/request-promise": "^4.1.48",
    "@types/ws": "^7.4.7",
    "@types/xml2js": "^0.4.9",
    "eslint": "^7.32.0",
    "jest": "^27.0.6",
    "nodemon": "^2.0.12",
    "prettier": "^2.3.2",
    "supertest": "^6.1.4",
    "ts-jest": "^27.0.4",
    "typescript": "^4.3.5"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "moduleFileExtensions": [
      "js",
      "ts",
      "json",
      "node"
    ],
    "testMatch": [
      "**/test/**/*.test.(js|ts)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,ts}",
      "!**/node_modules/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "lcov",
      "text"
    ],
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.json"
      }
    },
    "prettier": "2.7.1",
    "typescript": "4.5.2"
  }
}
